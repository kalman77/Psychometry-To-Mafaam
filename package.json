{
  "name": "mapam-builder",
  "version": "2.0.0",
  "description": "Turn any psychometric test into a timed MAPAM sitting.",
  "type": "module",
  "private": true,
  "bin": {
    "mapam": "./src/presentation/cli/main.ts"
  },
  "scripts": {
    "mapam": "node src/presentation/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:runner",
    "build:runner": "node scripts/build-runner.mjs",
    "test": "node --test \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2"
  }
}
